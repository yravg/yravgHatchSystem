{
  "name": "yravg-hatchsystem",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:ticket": "node tools/ticket-dispatch.ts",
    "validate:spec": "node tools/validate-spec.ts",
    "gen:contracts": "node packages/contracts/scripts/generate.ts",
    "gen:tokens": "node packages/ui/scripts/gen-tokens.ts",
    "test:e2e": "pnpm --filter @yravg/web build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@yravg/contracts": "workspace:*",
    "@yravg/domain": "workspace:*",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
